# Salin menjadi .env lalu isi nilainya. File .env TIDAK boleh di-commit.

# Dari: cd backend && php artisan key:generate --show   (hasilnya berawalan base64:)
APP_KEY=

DB_DATABASE=gudang
DB_USERNAME=gudang_user
# Hindari karakter $ dan spasi pada password
DB_PASSWORD=
DB_ROOT_PASSWORD=

# true = buat akun admin@example.com dan contoh barang saat container backend start
RUN_SEEDER=true
